# Backend environment.
#
# Copy to .env and fill in. This file documents NAMES ONLY — never commit a
# value here, not even a throwaway one (CLAUDE.md section 6). A test asserts
# that every name below is actually read by the code, and that every variable
# the code reads appears below.
#
# Variables marked REQUIRED are read without a default: if one is absent the
# process stops at import rather than falling back to something unsafe.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# Which settings module to load.
#   config.settings.local | config.settings.production | config.settings.test
# manage.py defaults to local; the ASGI and Celery entrypoints default to
# production, so a container with an unset environment fails loudly.
DJANGO_SETTINGS_MODULE=

# REQUIRED. Generate a fresh one per environment, never reuse across them.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Boolean. Defaults to off. Ignored by production settings, which assign it
# literally so a typo here cannot switch it on.
DJANGO_DEBUG=

# Comma-separated hostnames. Required in production.
DJANGO_ALLOWED_HOSTS=

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
DJANGO_LOG_LEVEL=

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

# REQUIRED. Postgres connection URL.
#   postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=

# REQUIRED. Redis URL, used as the Celery broker.
#   redis://HOST:PORT/DB
# Redis is disposable by design: it holds the queue and cache, never the only
# copy of anything. Sessions live in Postgres.
REDIS_URL=

# REQUIRED. Redis URL for the cache and DRF throttle counters.
#
# Must be a DIFFERENT database number from REDIS_URL. Sharing one means
# cache.clear() deletes queued Celery tasks — the queue empties, nothing
# raises, and the work simply never happens. A test asserts they differ.
REDIS_CACHE_URL=

# ---------------------------------------------------------------------------
# Email
#
# Local development only. Points at Mailpit in the compose stack, so nothing
# leaves the machine. Transactional email through a real provider arrives with
# the notifications app.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=

# ---------------------------------------------------------------------------
# Gunicorn
#
# All optional — gunicorn.conf.py carries defaults for every one. Override per
# environment only when there is a measured reason to.
# ---------------------------------------------------------------------------
GUNICORN_BIND=
GUNICORN_WORKERS=
GUNICORN_LOG_LEVEL=
GUNICORN_MAX_REQUESTS=
GUNICORN_MAX_REQUESTS_JITTER=
GUNICORN_TIMEOUT=
GUNICORN_GRACEFUL_TIMEOUT=
GUNICORN_KEEPALIVE=
