# Frontend environment.
#
# Copy to .env.local and fill in. This file documents NAMES ONLY — never commit
# a value here (CLAUDE.md section 6).
#
# Nothing in this application may be prefixed NEXT_PUBLIC_ unless it is
# genuinely safe in the browser: that prefix inlines the value into the client
# bundle at build time. Nothing auth-related belongs in the browser at all
# (invariant 9).

# Origin of the Django API, used server-side by the /api/* rewrite in
# next.config.ts. Deliberately NOT public — the internal API hostname should
# not ship to the browser.
#   http://localhost:8000   running the backend directly
#   http://api:8000         inside the compose network
# Defaults to http://localhost:8000 when unset.
API_ORIGIN=

# How a playback id becomes a URL, for the lesson player. Public on purpose:
# it is a URL template, not a credential, and the token that authorises
# playback is minted per request by the API.
#
# Two placeholders are substituted: {playback_id} and {token}. Unset — which is
# the case today, because no video provider has been chosen (M5 ships a fake
# one) — makes the lesson page fall back to a stand-in clock that reports
# progress exactly as a real player would.
NEXT_PUBLIC_PLAYBACK_URL_TEMPLATE=
