// Cloudflare Workers configuration for the Next.js frontend (B-lite, ADR-025).
//
// Generated by `opennextjs-cloudflare migrate` and then edited. What changed
// from the generated file, and why, is commented inline — the point of keeping
// it in the repository is that somebody can read the differences rather than
// diff it against a tool's output.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "e-platform-web",
	"compatibility_date": "2026-08-29",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "e-platform-web"
		}
	]

	// No "images" binding. `opennextjs-cloudflare migrate` adds one for Next's
	// image optimizer, and nothing in this application imports `next/image` —
	// the root layout says why there is no web font either. A binding for an
	// unused feature is configuration nobody can explain in six months, and
	// on Cloudflare it is also a billable product.
}